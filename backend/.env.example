# Copy to backend/.env (gitignored) to override defaults, OR set these as
# environment variables on your host. CRUD and Gmail sync work with no .env;
# extraction needs an API key for the selected EXTRACTOR.

# Extractor selection: "gemini" (default) | "ollama" | "claude"
EXTRACTOR=gemini

# Gemini (default extractor — hosted, free tier). Required when EXTRACTOR=gemini.
GEMINI_API_KEY=
# Set to your exact model string. This defaults to the current Gemini 3 Pro
# text model used for structured extraction.
GEMINI_MODEL=gemini-3.1-pro-preview
GEMINI_TIMEOUT_SECONDS=60

# Ollama (local alternative — only if EXTRACTOR=ollama)
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2
# OLLAMA_TIMEOUT_SECONDS=120

# Claude (only if EXTRACTOR=claude; also: pip install anthropic)
# ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_MODEL=claude-opus-4-8

# Gmail sync tuning (optional overrides — defaults live in app/config.py)
# GMAIL_SEARCH_QUERY=from:unstop.com OR "case competition" OR competition OR registered OR registration OR shortlisted OR round OR deadline OR submission OR submitted OR result OR rejected OR "not selected" OR "not qualified" OR selected OR qualified OR guidelines
# GMAIL_INITIAL_SYNC_DAYS=30
# GMAIL_MAX_MESSAGES_PER_SYNC=200

# Matching (Phase 4)
# FUZZY_NAME_THRESHOLD=0.75
