# Copy to backend/.env (gitignored) to override defaults. Everything works
# with no .env at all — these are the tunables.

# Extractor selection: "ollama" (default, local, free) or "claude"
EXTRACTOR=ollama

# Ollama (default extractor). llama3.2 is a light default; use a bigger
# model (e.g. llama3.1:8b) if your machine can run it — extraction improves.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT_SECONDS=120

# Claude extractor (only if EXTRACTOR=claude; also: pip install anthropic)
# ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_MODEL=claude-opus-4-8

# Gmail sync tuning (optional overrides — defaults live in app/config.py)
# GMAIL_SEARCH_QUERY=from:unstop.com OR "case competition" OR shortlisted OR round OR deadline OR submission OR selected
# GMAIL_INITIAL_SYNC_DAYS=30
# GMAIL_MAX_MESSAGES_PER_SYNC=200
